# Development settings. Copy to .env (gitignored). Production uses /etc/farmhand/farmhand.env.
NODE_ENV=development
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me-00
FARMHAND_PUBLIC_URL=http://localhost:5173
FARMHAND_DB=./farmhand.db
FARMHAND_DEV_ALLOW_LOOPBACK=1
FARMHAND_HELPER=fake
FARMHAND_LAN_IP=10.0.0.2

# Point at the fake farm (pnpm dev:fake)
PRINTSTASH_URL=http://127.0.0.1:13460
