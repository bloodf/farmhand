# /etc/farmhand/farmhand.env — read by farmhand.service. root:farmhand 0640.
# install.sh fills BETTER_AUTH_SECRET when it is blank and never overwrites this file.

NODE_ENV=production
# Port and addresses the server listens on (comma list). Loopback for a reverse
# proxy, plus the LAN address if people open it directly.
FARMHAND_PORT=3490
FARMHAND_HOST=127.0.0.1
# Origin the browser uses (scheme://host[:port]). Drives CSRF checks and cookie flags.
# If any address is plain http, this must be the http one, or cookies get the Secure flag.
FARMHAND_PUBLIC_URL=http://localhost:3490
# Other origins the UI is reachable from, comma list (a Tailscale or reverse-proxy name).
FARMHAND_TRUSTED_ORIGINS=
FARMHAND_DB=/var/lib/farmhand/farmhand.db
# 32+ random bytes: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Development only. Production refuses to start when this is set.
FARMHAND_DEV_ALLOW_LOOPBACK=
# No login at all: everyone who can reach farmhand is an admin. Only on a trusted network.
FARMHAND_OPEN_ACCESS=
FARMHAND_WEB_DIST=/opt/farmhand/apps/web/dist
# Address on the printers' LAN that Spoolman is reachable on (shown in setup snippets).
FARMHAND_LAN_IP=
# Interfaces whose directly connected networks count as the printer LAN (comma list).
FARMHAND_LAN_IFACES=br0
FARMHAND_HELPER=/run/farmhand/helper.sock
# Only used when FARMHAND_HELPER=fake.
FARMHAND_FAKE_HELPER_DIR=

PRINTSTASH_URL=http://127.0.0.1:3460
PRINTSTASH_USER=
PRINTSTASH_PASSWORD=
# Link shown to operators; empty hides the link.
PRINTSTASH_PUBLIC_URL=
FDM_URL=http://127.0.0.1:4000
FDM_USER=
FDM_PASSWORD=
FDM_PUBLIC_URL=
SPOOLMAN_URL=http://127.0.0.1:7912
SPOOLMAN_PUBLIC_URL=
ORCASLICER_URL=http://127.0.0.1:3470
ORCASLICER_PUBLIC_URL=

# Optional Home Assistant integration.
HA_URL=
HA_DISCOVERY_WEBHOOK=
