# Copy to .env in this directory. Read by docker compose, not by farmhand.
# Where every service keeps its data. Must match MR_CONF in /etc/farmhand/helper.env
# (MR_CONF=<FARMHAND_DATA_DIR>/mobileraker/mobileraker.conf).
FARMHAND_DATA_DIR=/srv/farmhand
TZ=UTC
# Address on the printers' LAN that Spoolman listens on. Same value as LAN_IP in helper.env.
LAN_IP=
PUID=1000
PGID=1000

# Only with docker-compose.postgres.yml:
# SPOOLMAN_DB_HOST=
# SPOOLMAN_DB_PORT=5432
# SPOOLMAN_DB_NAME=spoolman
# SPOOLMAN_DB_USERNAME=spoolman
# SPOOLMAN_DB_PASSWORD=
