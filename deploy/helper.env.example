# /etc/farmhand/helper.env — read by farmhand-helper (root) and farmhand-guard.sh.
# root:root 0644. Holds paths only, never secrets. The web server cannot write it.
# KEY=VALUE, no shell expansion. Empty means "use the default" or "feature off".

# Compose file(s) of the farm stack; several files are joined with ":".
COMPOSE_FILE=/opt/farmhand/deploy/compose/docker-compose.yml
COMPOSE_PROJECT=farmhand
# Approved printer IPs, one per line. Feeds farmhand-guard.
ALLOW_FILE=/etc/farmhand/printers.allow
# Mobileraker companion config: <FARMHAND_DATA_DIR>/mobileraker/mobileraker.conf
MR_CONF=/srv/farmhand/mobileraker/mobileraker.conf
# Empty disables allowlist verbs (they answer not_configured).
GUARD_UNIT=farmhand-guard.service
# systemd unit that runs your backup. Empty disables backup verbs.
BACKUP_UNIT=
LOCK_FILE=/run/lock/farmhand.lock
# Written into a new mobileraker.conf.
TZ=UTC
# Printer targets must sit in a network directly attached to one of these.
LAN_IFACES=br0
# Moonraker bridges on this host, ip:port comma list. Same value as
# FARMHAND_BRIDGE_TARGETS in farmhand.env. A malformed entry makes mobileraker-add refuse.
BRIDGE_TARGETS=
# uid of the farmhand user; install.sh fills it. Empty = only root may connect.
ALLOWED_UID=
# Address Spoolman binds on the printer LAN. Used by farmhand-guard.sh; empty = guard off.
LAN_IP=
